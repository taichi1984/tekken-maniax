  `evaluator_id` int NOT NULL,
  `guide_id` int NOT NULL,
  PRIMARY KEY (`id`),
  KEY `guide_evaluation_evaluator_id_da88d7f9_fk_top_customuser_id` (`evaluator_id`),
  KEY `guide_evaluation_guide_id_5b2b2da1_fk_guide_guide_id` (`guide_id`),
  CONSTRAINT `guide_evaluation_evaluator_id_da88d7f9_fk_top_customuser_id` FOREIGN KEY (`evaluator_id`) REFERENCES `top_customuser` (`id`),
  CONSTRAINT `guide_evaluation_guide_id_5b2b2da1_fk_guide_guide_id` FOREIGN KEY (`guide_id`) REFERENCES `guide_guide` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=23 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
