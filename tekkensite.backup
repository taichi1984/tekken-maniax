INSERT INTO `guide_character` VALUES (1,'その他','','Others','','','','総合'),(2,'仁','風間','Jin','Kazama','空手','日本','風間　仁'),(3,'一八','三島','Kazuya','Mishima','三島流喧嘩空手','無し(日本国籍は捨てた)','三島　一八'),(4,'準','風間','Jun','Kazama','風間流古武術','　日本','風間　準'),(5,'ポール','フェニックス','Paul','Phoenix','柔道をベースとした総合格闘技','アメリカ','ポール・フェニックス'),(6,'マーシャル','ロウ','Marshall','Law','マーシャル・アーツ','アメリカ','マーシャル・ロウ'),(7,'キング','','King','','プロレスリング','メキシコ','キング'),(8,'ラース','アレクサンダーソン','Lars','Alexandersson','鉄拳集特殊部隊格闘術','スウェーデン','ラース・アレクサンダーソン'),(9,'リン','シャオユウ','Ling','Xiaoyu','八卦掌、劈掛拳をベースとした各種中国拳法','中国','凌 暁雨'),(10,'ジャック8','','Jack-8','','力任せ','不明','ジャック8'),(11,'ニーナ','ウィリアムズ','Nina','Williams','暗殺格闘術','アイルランド','ニーナ・ウィリアムズ'),(12,'飛鳥','風間','Asuka','Kazama','風間流古武術','日本','風間　飛鳥'),(13,'リロイ','スミス','Leroy','Smith','詠春拳','アメリカ','リロイ・スミス'),(14,'リリ','','Lili','','我流','モナコ','リリ'),(15,'ファラン','','Hwoarang','','テコンドー','韓国','ファラン'),(16,'ブライアン','フューリー','Bryan','Fury','キックボクシング','アメリカ','ブライアン・フューリー'),(17,'クラウディオ','セラフィーノ','Claudio','Serafino','シリウス流祓魔術','イタリア','クラウディオ・セラフィーノ'),(18,'アズセナ','ミラグロス・オルティス・カスティーリョ','Azucena','Milagros Ortiz Castillo','総合格闘技(ストライカー)','ペルー','アズセナ'),(19,'レイヴン','','Raven','','忍術','不明','レイヴン'),(20,'吉光','','Yoshimitsu','','卍忍術進化型','無し(元日本)','吉光'),(21,'スティーブ','フォックス','Steve','Fox','ボクシング','イギリス','スティーブ・フォックス'),(22,'セルゲイ','ドラグノフ','Sergei','Dragunov','コマンドサンボ','ロシア','セルゲイ・ドラグノフ'),(23,'レオ','','Leo','','八極拳','ドイツ','レオ'),(24,'シャヒーン','','Shaheen','','軍隊式格闘術','サウジアラビア','シャヒーン'),(25,'クマ','','Kuma','','平八流熊真拳・改','無し','クマ'),(26,'フェン','ウェイ','Feng','Wei','太極拳','中国','馮 威'),(27,'パンダ','','Panda','','平八流熊真拳・改','無し','パンダ'),(28,'ザフィーナ','','Zafina','','古代暗殺術','不明','ザフィーナ'),(29,'リー','チャオラン','Lee','Chaolan','マーシャル・アーツ','日本','李　超狼'),(30,'アリサ','ボスコノビッチ','Alisa','Bosconovitch','スラスターを使用した高機動戦闘','ロシア','アリサ・ボスコノビッチ'),(31,'デビル','仁','Devil','Jin','不明','無し','デビル仁'),(32,'ヴィクター','シュヴァリエ','Victor','Chevalier','スーパースパイ式CQB','フランス','ヴィクター・シュヴァリエ'),(33,'麗奈','','Reina','','不明','不明','麗奈');
