DROP TABLE IF EXISTS `guide_guide`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `guide_guide` (
  `id` int NOT NULL AUTO_INCREMENT,
  `title` varchar(255) NOT NULL,
  `article` longtext NOT NULL,
  `pub_date` datetime(6) NOT NULL,
  `update_date` datetime(6) NOT NULL,
  `number_of_preview` bigint NOT NULL,
  `publishing_setting` tinyint(1) NOT NULL,
  `is_deleted` tinyint(1) NOT NULL,
  `author_id` int NOT NULL,
  `category_id` int NOT NULL,
  `character_id` int NOT NULL,
  PRIMARY KEY (`id`),
  KEY `guide_guide_author_id_b5c692a0_fk_top_customuser_id` (`author_id`),
  KEY `guide_guide_category_id_2bdcd9a6_fk_guide_category_id` (`category_id`),
  KEY `guide_guide_character_id_5da2f81d_fk_guide_character_id` (`character_id`),
  CONSTRAINT `guide_guide_author_id_b5c692a0_fk_top_customuser_id` FOREIGN KEY (`author_id`) REFERENCES `top_customuser` (`id`),
  CONSTRAINT `guide_guide_category_id_2bdcd9a6_fk_guide_category_id` FOREIGN KEY (`category_id`) REFERENCES `guide_category` (`id`),
  CONSTRAINT `guide_guide_character_id_5da2f81d_fk_guide_character_id` FOREIGN KEY (`character_id`) REFERENCES `guide_character` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=30 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

