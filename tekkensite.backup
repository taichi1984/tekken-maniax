INSERT INTO `guide_guide` VALUES (25,'テストガイドだよ～','<h1 id=\"h1_1\">\n 見出し１\n</h1>\n<p>\n 画面上部の標準のところで、見出しを作ることができます。\n</p>\n<p>\n こんな感じで見出しを設定してください。\n</p>\n<p>\n 見出し１～３までで設定した場所は自動的に目次が作られます。\n</p>\n<p>\n</p>\n<h2 id=\"h2_1\">\n 見出し2  - 技表だよ -\n</h2>\n<p>\n 表も簡単に差し込むことができます。\n</p>\n<table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width:800px\" summary=\"技表\">\n <tbody>\n  <tr>\n   <td>\n    技名\n   </td>\n   <td>\n    コマンド\n   </td>\n   <td>\n    備考\n   </td>\n  </tr>\n  <tr>\n   <td>\n    <p>\n     閃光烈拳\n    </p>\n   </td>\n   <td>\n    LPLPRP\n   </td>\n   <td>\n   </td>\n  </tr>\n  <tr>\n   <td>\n    風神拳\n   </td>\n   <td>\n    6n23RP\n   </td>\n   <td>\n   </td>\n  </tr>\n  <tr>\n   <td>\n    右踵落とし\n   </td>\n   <td>\n    6RK\n   </td>\n   <td>\n   </td>\n  </tr>\n  <tr>\n   <td>\n    奈落払い\n   </td>\n   <td>\n    6n23RK\n   </td>\n   <td>\n   </td>\n  </tr>\n </tbody>\n</table>\n<p>\n</p>\n<h3 id=\"h3_1\">\n 見出し3 - 文章だよ -\n</h3>\n<p>\n サンプル文章　なんちゃらかんちゃら\n</p>\n<p>\n これでどうですかね\n</p>\n<p>\n</p>\n<p>\n</p>\n<p>\n <strong>\n  太字テスト\n </strong>\n</p>\n<p>\n</p>\n<p>\n <span style=\"font-family:Comic Sans MS,cursive\">\n  <em>\n   イタリックテスト\n  </em>\n </span>\n</p>\n<p>\n</p>\n<p>\n <u>\n  下線テスト\n </u>\n</p>\n<p>\n</p>\n<p>\n <s>\n  打消し線テスト\n </s>\n</p>\n<p>\n</p>\n<ol>\n <li>\n  番号付きリスト\n </li>\n <li>\n  番号付きリスト２\n </li>\n <li>\n  番号付きリスト３\n </li>\n</ol>\n<p>\n</p>\n<ul>\n <li>\n  番号なしリスト\n </li>\n <li>\n  番号なしリスト２\n </li>\n <li>\n  番号なしリスト３\n </li>\n</ul>\n<p>\n</p>\n<p>\n <span style=\"color:#c0392b\">\n  <span style=\"font-size:28px\">\n   <span style=\"font-family:Comic Sans MS,cursive\">\n    ABCDEFG\n   </span>\n  </span>\n </span>\n</p>\n<p>\n</p>\n<p>\n <span style=\"color:#c0392b\">\n  <span style=\"font-size:28px\">\n   <span style=\"font-family:Comic Sans MS,cursive\">\n    <a href=\"https://www.youtube.com/\">\n     Youtubeへのリンク\n    </a>\n   </span>\n  </span>\n </span>\n</p>\n<p>\n</p>\n<p>\n</p>\n<p>\n <span style=\"color:#c0392b\">\n  <span style=\"font-size:28px\">\n   <span style=\"font-family:Comic Sans MS,cursive\">\n    チェックチェック　更新テスト\n   </span>\n  </span>\n </span>\n</p>\n<p>\n</p>\n<hr/>\n<p>\n にゃーにゃーにゃー ouie-\n</p>\n<p>\n <img alt=\"\" src=\"https://tamashiiweb.com/images/item/item_0000012205_xOVlreEa_01.jpg\" style=\"height:560px; width:560px\"/>\n</p>\n','2024-01-03 19:49:52.275897','2024-01-11 11:32:32.221751',362,1,0,1,1,1),(28,'ガイドの書き方について','<h1 id=\"h1_1\">\n ガイドの書き方\n</h1>\n<p>\n このページはガイドの書き方について、説明をします。\n</p>\n<p>\n このページ自体も当サイトのガイド機能で書かれているので、簡単にこのようなガイドを作ることができます。\n</p>\n<p>\n</p>\n<p>\n</p>\n<h1 id=\"h1_2\">\n 見出しについて\n</h1>\n<p>\n ガイドに見出しをつけることによって、ガイドが見やすくなります。\n</p>\n<p>\n ガイドはエディタ上部の段落の書式（初期で標準となっているところ）で見出しを選択することで、見出しにできます。\n</p>\n<p>\n 見出しを見出し１～見出し３に設定すると、各見出しをもとに目次を勝手に作ってくれます。\n</p>\n<p>\n</p>\n<h2 id=\"h2_1\">\n これが見出しサイズ２です。\n</h2>\n<h3 id=\"h3_1\">\n これが見出しサイズ３です。この大きさまでは目次になります。\n</h3>\n<p>\n</p>\n<h1 id=\"h1_3\">\n 文字の修飾について\n</h1>\n<p>\n エディタ左上の部分で文字の修飾ができます。\n</p>\n<p>\n 文字を書いた後にカーソルで修飾したい部分を選択して、各種修飾のボタンを押してください。\n</p>\n<p>\n</p>\n<p>\n <strong>\n  太字\n </strong>\n</p>\n<p>\n <em>\n  Itaric\n </em>\n</p>\n<p>\n</p>\n<p>\n <u>\n  下線\n </u>\n</p>\n<p>\n <s>\n  取り消し\n </s>\n</p>\n<p>\n など様々な文字を書くことができます。\n</p>\n<p>\n</p>\n<h1 id=\"h1_4\">\n リストについて\n</h1>\n<p>\n 番号ありリストと番号なしリストの２種類を作成できます。\n</p>\n<p>\n エディタ上部の番号ありリストのボタンをクリックしたあとに何か書いてみましょう。\n</p>\n<ol>\n <li>\n  これが\n </li>\n <li>\n  番号あり\n </li>\n <li>\n  リストです\n </li>\n</ol>\n<p>\n</p>\n<ul>\n <li>\n  これが番号なし\n </li>\n <li>\n  の\n </li>\n <li>\n  リストですよ\n </li>\n</ul>\n<p>\n このように簡単にリストを作成することができます。\n</p>\n<p>\n</p>\n<h1 id=\"h1_5\">\n ブロック引用について\n</h1>\n<p>\n エディタ上部の　二重引用符(”)　のマークをクリックすると引用のためのブロックがでてきます。\n</p>\n<p>\n</p>\n<blockquote>\n <p>\n  こんな感じで引用ブロックができます。\n </p>\n <p>\n  いかにも引用した内容なんだなといったような見た目になります。\n </p>\n</blockquote>\n<p>\n</p>\n<p>\n このように見た目をわかりやすくしたりできます。\n</p>\n<p>\n</p>\n<h1 id=\"h1_6\">\n フォントについて\n</h1>\n<h2 id=\"h2_2\">\n フォントの変更\n</h2>\n<p>\n 画面上部のフォントの項目を選択するとフォントを変更することができます。\n</p>\n<p>\n ですが現状英語のフォントぐらいしか切り替えることができないので、あまり使えないかもしれません\n</p>\n<p>\n <span style=\"font-family:Comic Sans MS,cursive\">\n  <span style=\"font-size:28px\">\n   TEKKEN 8\n  </span>\n </span>\n</p>\n<p>\n <span style=\"font-size:26px\">\n  TEKKEN 8\n </span>\n</p>\n<p>\n <span style=\"font-size:16px\">\n  こんな感じで現状英語ならちょっとだけフォントを変えることができます。\n </span>\n</p>\n<h2 id=\"h2_3\">\n <span style=\"font-size:24px\">\n  フォントサイズの変更\n </span>\n</h2>\n<p>\n <span style=\"font-size:16px\">\n  文字のサイズを変更できます。画面上部のサイズの部分で変更できます。\n </span>\n</p>\n<p>\n <span style=\"font-size:16px\">\n  見出しの文字サイズも変更できますが、文字のサイズが変わっても見出しであることは変わりません。（目次に登録されます)\n </span>\n</p>\n<p>\n</p>\n<h2 id=\"h2_4\">\n 色の変更\n</h2>\n<p>\n <span style=\"color:#f39c12\">\n  文字色も自由に変えれるし、文字の背景色も変えることができます。\n </span>\n</p>\n<p>\n <span style=\"color:#ffffff\">\n  <span style=\"background-color:#000000\">\n   このような感じで背景色と文字を自由に変更できます。\n  </span>\n </span>\n</p>\n<p>\n 文字の強調をしたいときや、伏字にしたいときなどに利用できます。\n</p>\n<p>\n</p>\n<p>\n</p>\n<h1 id=\"h1_7\">\n リンクについて\n</h1>\n<p>\n リンクの挿入が可能です。\n</p>\n<p>\n エディタ上部のクサリのマークをクリックするとリンクを作るためのダイアログがでてきます。\n</p>\n<p>\n</p>\n<p>\n <a href=\"https://extreme-gamers.info/guide/\">\n  ガイドのトップページだよ\n </a>\n</p>\n<p>\n</p>\n<p>\n このような感じで簡単に差し込めます\n</p>\n<p>\n</p>\n<h1 id=\"h1_8\">\n 公開設定について\n</h1>\n<p>\n エディタのすぐ下に公開するのチェックがありますが、これにチェックを入れて送信すると、記事がみんなに公開されます。\n</p>\n<p>\n 自分だけが見れるメモにしたり、下書きで保存しておきたい場合は公開するのチェックを外して投稿すると、他の人からは閲覧ができないようになります。\n</p>\n<p>\n 公開設定はあなたの書いたガイドのページから簡単に切り替えることができます。\n</p>\n<p>\n また編集もあなたの書いたガイドのページから簡単に行えますので、そちらから行ってください。\n</p>\n<p>\n</p>\n<p>\n</p>\n<p>\n</p>\n<p>\n <p>\n </p>\n</p>\n','2024-01-11 09:45:15.098141','2024-01-11 10:49:59.702758',3,1,0,3,1,1),(29,'ガイドの書き方について','<h1 id=\"h1_1\">\n ガイドの書き方\n</h1>\n<p>\n このページはガイドの書き方について、説明をします。\n</p>\n<p>\n このページ自体も当サイトのガイド機能で書かれているので、簡単にこのようなガイドを作ることができます。\n</p>\n<p>\n</p>\n<p>\n</p>\n<h1 id=\"h1_2\">\n 見出しについて\n</h1>\n<p>\n ガイドに見出しをつけることによって、ガイドが見やすくなります。\n</p>\n<p>\n ガイドはエディタ上部の段落の書式（初期で標準となっているところ）で見出しを選択することで、見出しにできます。\n</p>\n<p>\n 見出しを見出し１～見出し３に設定すると、各見出しをもとに目次を勝手に作ってくれます。\n</p>\n<p>\n</p>\n<h2 id=\"h2_1\">\n これが見出しサイズ２です。\n</h2>\n<h3 id=\"h3_1\">\n これが見出しサイズ３です。この大きさまでは目次になります。\n</h3>\n<p>\n</p>\n<h1 id=\"h1_3\">\n 文字の修飾について\n</h1>\n<p>\n エディタ左上の部分で文字の修飾ができます。\n</p>\n<p>\n 文字を書いた後にカーソルで修飾したい部分を選択して、各種修飾のボタンを押してください。\n</p>\n<p>\n</p>\n<p>\n <strong>\n  太字\n </strong>\n</p>\n<p>\n <em>\n  Itaric\n </em>\n</p>\n<p>\n</p>\n<p>\n <u>\n  下線\n </u>\n</p>\n<p>\n <s>\n  取り消し\n </s>\n</p>\n<p>\n など様々な文字を書くことができます。\n</p>\n<p>\n</p>\n<h1 id=\"h1_4\">\n リストについて\n</h1>\n<p>\n 番号ありリストと番号なしリストの２種類を作成できます。\n</p>\n<p>\n エディタ上部の番号ありリストのボタンをクリックしたあとに何か書いてみましょう。\n</p>\n<ol>\n <li>\n  これが\n </li>\n <li>\n  番号あり\n </li>\n <li>\n  リストです\n </li>\n</ol>\n<p>\n</p>\n<ul>\n <li>\n  これが番号なし\n </li>\n <li>\n  の\n </li>\n <li>\n  リストですよ\n </li>\n</ul>\n<p>\n このように簡単にリストを作成することができます。\n</p>\n<p>\n</p>\n<h1 id=\"h1_5\">\n ブロック引用について\n</h1>\n<p>\n エディタ上部の　二重引用符(”)　のマークをクリックすると引用のためのブロックがでてきます。\n</p>\n<p>\n</p>\n<blockquote>\n <p>\n  こんな感じで引用ブロックができます。\n </p>\n <p>\n  いかにも引用した内容なんだなといったような見た目になります。\n </p>\n</blockquote>\n<p>\n</p>\n<p>\n このように見た目をわかりやすくしたりできます。\n</p>\n<p>\n</p>\n<h1 id=\"h1_6\">\n フォントについて\n</h1>\n<h2 id=\"h2_2\">\n フォントの変更\n</h2>\n<p>\n 画面上部のフォントの項目を選択するとフォントを変更することができます。\n</p>\n<p>\n ですが現状英語のフォントぐらいしか切り替えることができないので、あまり使えないかもしれません\n</p>\n<p>\n <span style=\"font-family:Comic Sans MS,cursive\">\n  <span style=\"font-size:28px\">\n   TEKKEN 8\n  </span>\n </span>\n</p>\n<p>\n <span style=\"font-size:26px\">\n  TEKKEN 8\n </span>\n</p>\n<p>\n <span style=\"font-size:16px\">\n  こんな感じで現状英語ならちょっとだけフォントを変えることができます。\n </span>\n</p>\n<h2 id=\"h2_3\">\n <span style=\"font-size:24px\">\n  フォントサイズの変更\n </span>\n</h2>\n<p>\n <span style=\"font-size:16px\">\n  文字のサイズを変更できます。画面上部のサイズの部分で変更できます。\n </span>\n</p>\n<p>\n <span style=\"font-size:16px\">\n  見出しの文字サイズも変更できますが、文字のサイズが変わっても見出しであることは変わりません。（目次に登録されます)\n </span>\n</p>\n<p>\n</p>\n<h2 id=\"h2_4\">\n 色の変更\n</h2>\n<p>\n <span style=\"color:#f39c12\">\n  文字色も自由に変えれるし、文字の背景色も変えることができます。\n </span>\n</p>\n<p>\n <span style=\"color:#ffffff\">\n  <span style=\"background-color:#000000\">\n   このような感じで背景色と文字を自由に変更できます。\n  </span>\n </span>\n</p>\n<p>\n 文字の強調をしたいときや、伏字にしたいときなどに利用できます。\n</p>\n<p>\n</p>\n<p>\n</p>\n<h1 id=\"h1_7\">\n リンクについて\n</h1>\n<p>\n リンクの挿入が可能です。\n</p>\n<p>\n エディタ上部のクサリのマークをクリックするとリンクを作るためのダイアログがでてきます。\n</p>\n<p>\n</p>\n<p>\n <a href=\"https://extreme-gamers.info/guide/\">\n  ガイドのトップページだよ\n </a>\n</p>\n<p>\n</p>\n<p>\n このような感じで簡単に差し込めます\n</p>\n<p>\n</p>\n<h1 id=\"h1_8\">\n 公開設定について\n</h1>\n<p>\n エディタのすぐ下に公開するのチェックがありますが、これにチェックを入れて送信すると、記事がみんなに公開されます。\n</p>\n<p>\n 自分だけが見れるメモにしたり、下書きで保存しておきたい場合は公開するのチェックを外して投稿すると、他の人からは閲覧ができないようになります。\n</p>\n<p>\n 公開設定はあなたの書いたガイドのページから簡単に切り替えることができます。\n</p>\n<p>\n また編集もあなたの書いたガイドのページから簡単に行えますので、そちらから行ってください。\n</p>\n<p>\n</p>\n<p>\n</p>\n<p>\n</p>\n<p>\n</p>\n<p>\n</p>\n<p>\n</p>\n','2024-01-11 09:48:14.696729','2024-01-11 10:50:16.477054',5,1,0,1,1,1);
