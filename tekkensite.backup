INSERT INTO `top_userprofile` VALUES (1,'キックミーN森','サイトの管理をしてます。\r\nよろしくお願いします。',0,1,1,'https://www.twitch.tv/kickme_twitch','kickmeNmori2','https://www.youtube.com/channel/UCLO43uurxAlYLwPyrx1s1Hw'),(2,'たいち','間違えて作っちゃった',0,2,2,'','',''),(3,'yajima','test',0,4,4,'','',''),(4,'','',0,1,5,'','',''),(5,'ちちぴんが。','ジョシー、ガンリュウメイン帝段\r\nPS4、steam共にプレイしてます。\r\n',0,21,6,'','TTPNG',''),(6,'ＰＡＲ','ＰＡＲです！鉄拳やってません！宜しくお願いします！',0,12,7,'','yusuke0645_par',''),(7,'kou','　',0,1,8,'','',''),(8,'ヒート☆たけし','どうも、尿道に乾燥パスタぶっさし、小便で戻しおじさんです。',0,23,9,'','',''),(9,'','',0,1,10,'','','');
