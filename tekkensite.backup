  `thumbnails_medium` varchar(255) NOT NULL,
  `thumbnails_high` varchar(255) NOT NULL,
  `live_broadcast_content` varchar(100) NOT NULL,
  `publish_time` datetime(6) NOT NULL,
  `update_playlist` varchar(50) NOT NULL,
  `is_broadcasting` tinyint(1) NOT NULL,
  `latest_video_id` varchar(50) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=775 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
