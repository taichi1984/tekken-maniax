DROP TABLE IF EXISTS `top_userprofile`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `top_userprofile` (
  `id` int NOT NULL AUTO_INCREMENT,
  `nick_name` varchar(50) NOT NULL,
  `introduction` longtext NOT NULL,
  `is_deleted` tinyint(1) NOT NULL,
  `main_character_id` int NOT NULL,
  `user_id` int NOT NULL,
  `twitch_url` varchar(255) NOT NULL,
  `twitter_account` varchar(60) NOT NULL,
  `youtube_channel_url` varchar(60) NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `user_id` (`user_id`),
  KEY `top_userprofile_main_character_id_7618bafc_fk_guide_character_id` (`main_character_id`),
  CONSTRAINT `top_userprofile_main_character_id_7618bafc_fk_guide_character_id` FOREIGN KEY (`main_character_id`) REFERENCES `guide_character` (`id`),
  CONSTRAINT `top_userprofile_user_id_8cfc9bf4_fk_top_customuser_id` FOREIGN KEY (`user_id`) REFERENCES `top_customuser` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=10 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
